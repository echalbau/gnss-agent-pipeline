# LLM nodes (product agent, precision evaluator, report writer).
# Leave empty to run fully deterministic (heuristic retuning + template summary).
ANTHROPIC_API_KEY=
GNSS_LLM_MODEL=claude-sonnet-5-5

# RTKLIB console solver (demo5 build recommended)
RNX2RTKP=rnx2rtkp

# Optional override of src/gnss_pipeline/settings.yaml (deep-merged)
# GNSS_PIPELINE_CONFIG=config/local.yaml
GNSS_WORKERS=2
